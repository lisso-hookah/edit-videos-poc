{
  "productName": "Edit Videos",
  "version": "0.1.0",
  "identifier": "com.editvideos.app",
  "build": {
    "frontendDist": "../src/edit_videos_poc/web/static",
    "devUrl": "http://localhost:18374"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Edit Videos",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://localhost:18374; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/edit-videos-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": false,
      "sidecar": true
    }
  }
}
