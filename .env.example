# ══════════════════════════════════════════════════════════════
# API キー
# ══════════════════════════════════════════════════════════════

# Gemini API キー（Video / Short パイプラインの字幕フィラー除去に必要）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API キー（サムネイル生成に使用、任意）
# 取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ══════════════════════════════════════════════════════════════
# ロリポップ Web サービス設定
# ══════════════════════════════════════════════════════════════

# ロリポップのドメイン（末尾スラッシュなし）
LOLLIPOP_API_URL=https://your-domain.example.com

# api.php の WORKER_KEY と完全一致させる（ランダムな長い文字列を設定）
WORKER_KEY=CHANGE_ME_worker_secret_key

# ══════════════════════════════════════════════════════════════
# オプション設定（必要に応じてコメントアウトを外す）
# ══════════════════════════════════════════════════════════════

# Gemini モデル名（デフォルト: gemini-3-flash-preview）
# GEMINI_MODEL=gemini-3-flash-preview

# Whisper モデル（デフォルト: large-v3、CLI 実行時）
# WHISPER_MODEL=medium

# 処理結果の出力先（デフォルト: ./output）
# WORK_DIR=./output

# サムネイル生成モデル（デフォルト: gpt-image-2）
# IMAGE_MODEL=gpt-image-2
