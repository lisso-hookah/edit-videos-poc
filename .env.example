# ══════════════════════════════════════════════════════════════
# API キー
# ══════════════════════════════════════════════════════════════

# Gemini API キー（Video / Short パイプラインの字幕フィラー除去に使用。未設定ならスキップ）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API キー（サムネイル生成に使用、任意）
# 取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ══════════════════════════════════════════════════════════════
# ロリポップ Web サービス設定（scripts/run_worker.py を使う場合のみ）
# ══════════════════════════════════════════════════════════════

# ロリポップのドメイン（末尾スラッシュなし）
LOLLIPOP_API_URL=https://your-domain.example.com

# api.php の WORKER_KEY と完全一致させる（ランダムな長い文字列を設定）
WORKER_KEY=CHANGE_ME_worker_secret_key

# ══════════════════════════════════════════════════════════════
# オプション設定（必要に応じてコメントアウトを外す）
# ══════════════════════════════════════════════════════════════

# Gemini モデル名（デフォルト: gemini-3-flash-preview）
# GEMINI_MODEL=gemini-3-flash-preview

# Whisper モデル（デフォルト: large-v3、CLI 実行時）
# WHISPER_MODEL=medium

# 処理結果の出力先（デフォルト: ./output）
# WORK_DIR=./output

# サムネイル生成モデル（デフォルト: gpt-image-2）
# IMAGE_MODEL=gpt-image-2

# 文字起こしデバイス（デフォルト: 自動判定。cpu / cuda で強制）
# WHISPER_DEVICE=cpu

# 字幕フォント（デフォルト: OS の日本語フォント）
# SUBTITLE_FONT=Yu Gothic

# ffmpeg 実行ファイル（デフォルト: PATH 上の ffmpeg → 同梱 ffmpeg）
# FFMPEG_BINARY=C:\tools\ffmpeg\bin\ffmpeg.exe

# ローカル Web UI: 同時実行ジョブ数（デフォルト: 1）
# EDIT_VIDEOS_MAX_JOBS=1

# ローカル Web UI: アップロード・出力を自動削除するまでの日数（デフォルト: 7、0 で削除しない）
# EDIT_VIDEOS_RETENTION_DAYS=7
