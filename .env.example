# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API key — https://platform.openai.com/api-keys (サムネイル生成に使用)
OPENAI_API_KEY=

# ── ロリポップ Web サービス用 ──────────────────────────────────
# ロリポップのドメイン (末尾スラッシュなし)
LOLLIPOP_API_URL=https://your-domain.example.com

# api.php の WORKER_KEY と完全一致させる
WORKER_KEY=CHANGE_ME_worker_secret_key

# Optional overrides
# GEMINI_MODEL=gemini-3-flash-preview
# WHISPER_MODEL=large-v3
# WORK_DIR=./output
# IMAGE_MODEL=gpt-image-2
